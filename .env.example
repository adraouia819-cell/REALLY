# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Laisser vide en mode vitrine frontend.
# Renseigner l'URL de votre API backend (Node/Express, Laravel, Supabase Edge, etc.) pour activer l'enregistrement en base de données et les paiements CMI / Payzone.
VITE_API_BASE_URL=
